  "lenses": [
    {
      "name": "The one idea",
      "description": "Explain the single idea the resource turns on, for a reader who has not taken the course, with the resource as the only source for what it says."
    },
    {
      "name": "Work the problem",
      "description": "Pick one problem (or the hardest exam question) and solve it on the page, step by step, with the arithmetic shown."
    },
    {
      "name": "Chart it",
      "description": "Find the quantity the resource is about and chart it from a real dataset: 8 or more points, sourced, with the resource explaining what the chart shows."
    },
    {
      "name": "Where it came from",
      "description": "The history of the idea: who found it, when, what it replaced, and how the course teaches it differently from how it was discovered."
    },
    {
      "name": "Why it matters now",
      "description": "Tie the idea to something dated in this month's news, and let the resource do the explaining."
    },
    {
      "name": "Across the river",
      "description": "The same idea as another field sees it: a physics note read by an economist, a planning case read by an engineer."
    }
  ]
