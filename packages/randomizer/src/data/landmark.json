  "lenses": [
    {
      "name": "Why it won",
      "description": "Put the official motivation beside the work itself: what exactly the committee rewarded, where in the paper or book that result is, and what the motivation leaves out. The motivation is quoted verbatim, never paraphrased."
    },
    {
      "name": "One figure",
      "description": "Find the central figure, table, theorem or passage of the work and rebuild it as one chart from its own numbers (or the numbers it argues from), with the page or section cited."
    },
    {
      "name": "What it replaced",
      "description": "What the field believed before this work, the evidence that turned it over, and who held the old view, from the record. State the old view fairly."
    },
    {
      "name": "Read it today",
      "description": "A reader's guide to the work itself: its structure, the one passage or equation to read first, what a reader needs to know going in, and where to read it free of charge."
    },
    {
      "name": "Citation trail",
      "description": "How the work travelled: citations by year, the lag from publication to prize, who built on it and in which fields, from OpenAlex and the work's own references."
    },
    {
      "name": "Missing names",
      "description": "Who else did the work: the co-authors, the rivals and the predecessors the citation does not name, stated from the record and labelled where it is contested."
    },
    {
      "name": "Explain like I'm 5",
      "description": "Explain the result to a five-year-old: one everyday object or scene stands in for it, no symbol or term a child would not know, and then say where the picture stops being true, with the work as the source for the real thing."
    }
  ]
}
