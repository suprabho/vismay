{
  "name": "@vismay/html-stories",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-authored, self-contained HTML stories: storage, metadata extraction, site chrome, the agent brief (per app: vizmaya-fyi, footshorts), and the shared serve/publish/brief route handlers. Its own package so changes here only rebuild admin, vizmaya-fyi and footshorts web.",
  "exports": {
    "./apps": "./src/apps.ts",
    "./htmlStories": "./src/htmlStories.ts",
    "./meta": "./src/meta.ts",
    "./brief": "./src/brief.ts",
    "./footshortsBrief": "./src/footshortsBrief.ts",
    "./briefApi": "./src/briefApi.ts",
    "./publishApi": "./src/publishApi.ts",
    "./serve": "./src/serve.ts",
    "./branding": "./src/branding.ts",
    "./styles": "./src/styles.ts",
    "./storyStyles": "./src/storyStyles.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vismay/content-source": "workspace:*",
    "@vismay/viz-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
