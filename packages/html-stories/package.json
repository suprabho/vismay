{
  "name": "@vismay/html-stories",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-authored, self-contained HTML stories: storage, metadata extraction, site chrome, the agent brief (per app: vizmaya-fyi, footshorts, vizf1; per story format: scroll, book, board, deck, and recap on vizf1; a vizmaya brief can carry a randomizer spin), the hosted format runtimes (formats/), and the shared serve/publish/brief route handlers. Its own package so changes here only rebuild admin, vizmaya-fyi, footshorts web and vizf1 web.",
  "exports": {
    "./apps": "./src/apps.ts",
    "./htmlStories": "./src/htmlStories.ts",
    "./meta": "./src/meta.ts",
    "./brief": "./src/brief.ts",
    "./footshortsBrief": "./src/footshortsBrief.ts",
    "./vizf1Brief": "./src/vizf1Brief.ts",
    "./briefApi": "./src/briefApi.ts",
    "./publishApi": "./src/publishApi.ts",
    "./serve": "./src/serve.ts",
    "./branding": "./src/branding.ts",
    "./styles": "./src/styles.ts",
    "./storyStyles": "./src/storyStyles.ts",
    "./randomizerApi": "./src/randomizerApi.ts",
    "./formats": "./src/formats.ts",
    "./formatsApi": "./src/formatsApi.ts",
    "./assetsApi": "./src/assetsApi.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:formats": "tsx scripts/gen-format-assets.ts"
  },
  "dependencies": {
    "@vismay/ai-gateway": "workspace:*",
    "@vismay/content-source": "workspace:*",
    "@vismay/f1-viz": "workspace:*",
    "@vismay/randomizer": "workspace:*",
    "@vismay/viz-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
