# apps/viznba/worker/.env — server-only secrets. Never commit .env.
# Copy this file to .env and fill in real values.

# Supabase — project URL and service-role key (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...           # service_role key (NOT anon)

# Vercel AI Gateway — Jev (topic + entity gate) and Claude Haiku (summary +
# extraction) both go through @vismay/ai-gateway. Required for ingest:news.
AI_GATEWAY_API_KEY=
TEXT_MODEL=                                  # optional override, e.g. text.sonnet

# Jev entity-tag precision gate (src/jevEntityGate.ts)
JEV_ENTITY_GATE=1                            # set 0 to tag every resolved entity
JEV_ENTITY_MIN_CONFIDENCE=0.55               # tags below this are dropped
