# apps/worker/.env — server-only secrets. Never commit .env, never ship to the client.
# Copy this file to .env and fill in real values.

# ──────────────────────────────────────────────────────────
# Supabase — project URL and service-role key
# Get from: Supabase dashboard → Settings → API
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...           # service_role key (NOT anon)

# ──────────────────────────────────────────────────────────
# Vercel AI Gateway — every LLM call in this worker goes through it
# (@vismay/ai-gateway): Jev (`typesafe-ai/jev`) for decisions — is this
# football, which topic, is this tag a real subject — and Claude for writing:
#   - summarize.ts, squads/adapters/llm-extract.ts → Claude Haiku (text.haiku)
#   - recap.ts, theanalystPowerRankings.ts         → Claude Sonnet (text.sonnet)
#   - eval/run.ts judge                            → Claude Opus (EVAL_JUDGE_MODEL)
# Same key admin + story-pipeline already use; on Vercel the injected OIDC
# token stands in for it. Required for ingest. Without it, recap and power
# rankings still run, minus their narratives.
# Get from: Vercel dashboard → AI Gateway → API keys
# ──────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=
TEXT_MODEL=                                  # optional override (alias like text.sonnet, or a gateway id);
                                             # default is each module's tier above

# ──────────────────────────────────────────────────────────
# football-data.org — used by apps/worker/src/seed.ts to populate leagues + teams
# Get from: https://www.football-data.org/client/register (free tier: 10 req/min)
# Upgrade to Standard (€29–49/mo) before commercial launch
# ──────────────────────────────────────────────────────────
FOOTBALL_DATA_TOKEN=

# ──────────────────────────────────────────────────────────
# Jev entity-tag precision gate — apps/worker/src/jevEntityGate.ts
# After the resolver maps the extracted entity names to canonical rows, Jev
# judges each candidate — "subject of the article, or mentioned in passing?" —
# and the probability is stored as article_entities.confidence.
# Uses AI_GATEWAY_API_KEY above. Without credentials the gate is skipped:
# every resolved entity is then tagged at confidence 1.0, as before the gate
# existed.
# ──────────────────────────────────────────────────────────
JEV_ENTITY_GATE=1                            # set 0 to disable without removing the key
JEV_ENTITY_MIN_CONFIDENCE=0.55               # optional; tags below this are dropped
JEV_MODEL=typesafe-ai/jev                    # optional decision-model override (all Jev calls)
AI_GATEWAY_DECIDE_TIMEOUT_MS=30000           # optional; overall budget per Jev request incl. retries
