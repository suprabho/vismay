# apps/worker/.env — server-only secrets. Never commit .env, never ship to the client.
# Copy this file to .env and fill in real values.

# ──────────────────────────────────────────────────────────
# Supabase — project URL and service-role key
# Get from: Supabase dashboard → Settings → API
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...           # service_role key (NOT anon)

# ──────────────────────────────────────────────────────────
# Gemini — used by apps/worker/src/gemini.ts for summarization + entity extraction
# Get from: https://aistudio.google.com → Get API key (free tier, no card)
# ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash                # optional override; default is flash

# ──────────────────────────────────────────────────────────
# football-data.org — used by apps/worker/src/seed.ts to populate leagues + teams
# Get from: https://www.football-data.org/client/register (free tier: 10 req/min)
# Upgrade to Standard (€29–49/mo) before commercial launch
# ──────────────────────────────────────────────────────────
FOOTBALL_DATA_TOKEN=

# ──────────────────────────────────────────────────────────
# TypeSafe (Jev) — entity-tag precision gate, apps/worker/src/jevEntityGate.ts
# After the resolver maps Gemini's entity names to canonical rows, Jev judges
# each candidate ("subject of the article, or mentioned in passing?") and the
# probability is stored as article_entities.confidence.
# Leave TYPESAFE_API_KEY blank to disable — every resolved entity is then
# tagged at confidence 1.0, exactly as before the gate existed.
# Get from: https://typesafe.ai
# ──────────────────────────────────────────────────────────
TYPESAFE_API_KEY=
JEV_ENTITY_GATE=1                            # set 0 to disable without removing the key
JEV_ENTITY_MIN_CONFIDENCE=0.55               # optional; tags below this are dropped
TYPESAFE_DEFAULT_MODEL=jev-latest            # optional override
