NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Amplitude (optional — analytics are a no-op without it)
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# Set to EU to send to Amplitude's EU data center (defaults to US)
# NEXT_PUBLIC_AMPLITUDE_SERVER_ZONE=EU
# HTML stories (packages/html-stories): /s/<slug> and /api/html-stories read the
# RLS-locked html_stories table, so the service role key is needed here too.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token agents post with (POST /api/html-stories) and that unlocks the
# match context on /api/html-stories/brief. Any long random string.
HTML_STORIES_TOKEN=
