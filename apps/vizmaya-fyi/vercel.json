{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs",
  "crons": [
    {
      "path": "/api/ai-data-centers/cron/morning",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/ai-data-centers/cron/publish",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/ai-data-centers/cron/publish-late",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/randomizer/cron/ocw",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/randomizer/cron/landmark",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/randomizer/cron/hundred",
      "schedule": "50 5 * * *"
    },
    {
      "path": "/api/randomizer/cron/evidence",
      "schedule": "55 5 * * *"
    },
    {
      "path": "/api/randomizer/cron/frontier",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/randomizer/cron/curious",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/curious/cron/collect-gdelt",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/curious/cron/collect-loc",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/curious/cron/detect",
      "schedule": "50 3 * * *"
    }
  ]
}
