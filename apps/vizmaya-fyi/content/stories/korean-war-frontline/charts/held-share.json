        "series": [
          {
            "name": "Held by North",
            "type": "line",
            "smooth": false,
            "symbol": "circle",
            "symbolSize": 7,
            "lineStyle": { "color": "$red", "width": 2.5 },
            "itemStyle": { "color": "$red" },
            "areaStyle": { "color": "$red", "opacity": 0.18 },
            "label": {
              "show": true,
              "position": "top",
              "color": "$text",
              "fontFamily": "IBM Plex Mono",
              "fontSize": 11,
              "formatter": "{c}%"
            },
            "markLine": {
              "silent": true,
              "symbol": "none",
              "lineStyle": { "color": "$amber", "type": "dashed", "width": 1.5 },
              "label": { "color": "$amber", "formatter": "June 1950 · 57%", "position": "insideEndTop" },
              "data": [{ "yAxis": 57 }]
            },
            "data": [57, 68, 94, 56, 18, 56, 67, 57, 61, 56, 56, 56]
          }
        ]
      }
    }
  ]
